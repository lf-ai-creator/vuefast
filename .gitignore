dist/
dist-ssr/
coverage/
.nyc_output/
playwright-report/
test-results/

# Python 虚拟环境与工具缓存（保留 uv.lock）
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv/
.coverage
.coverage.*
htmlcov/

# 本地环境配置；客户端共享环境配置仍纳入版本控制
.env
.env.local
.env.*.local
!.env.example
!.env.sample
!.env.template

# 启停脚本状态、日志与临时文件
.runtime/
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.tmp
*.temp
