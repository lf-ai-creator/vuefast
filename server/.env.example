# 复制为 .env；按本地部署填写。不要提交真实凭据。
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/youlai_admin
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TYPE=jwt
# 必填：使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成。
JWT_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=false
