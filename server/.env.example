# 复制为 .env；按本地部署填写。不要提交真实凭据。

# ==================== 数据库 ====================
DATABASE_URL=postgresql+asyncpg://postgres:your_password@127.0.0.1:5432/youlai_admin

# ==================== Redis ====================
REDIS_URL=redis://:your_redis_password@127.0.0.1:6379/0

# ==================== 认证 ====================
SESSION_TYPE=jwt
# 必填：使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成随机密钥。
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
ALLOW_MULTI_LOGIN=true

# ==================== S3（RustFS）文件存储 ====================
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_BUCKET=public
S3_SECURE=false

# ==================== 邮件 ====================
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==================== 限流 ====================
# IP 全局限流总开关（默认开启；开启后单 IP 每 60s 最多 1000 请求）
RATE_LIMIT_ENABLED=true

# ==================== CORS ====================
ALLOWED_ORIGINS=*

# ==================== 文件上传 ====================
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,xlsx,xls,docx,doc,zip

# ==================== 调试 ====================
DEBUG=false
LOG_LEVEL=INFO
