    async def get_page(self, query: [[ entity_name ]]QueryParams) -> PageResult:
        """按查询条件分页返回[[ business_name ]]。"""
{% if soft_delete_filter %}        conditions = [[ lb ]][[ entity_name ]].is_deleted == 0]
{% else %}        conditions = []
{% endif %}{% for c in query_columns %}
        value = getattr(query, "[[ c.field_name ]]", None)
        if value is not None and value != "":
{% if c.query_type_name == "BETWEEN" %}            values = value if isinstance(value, list) else [value]
            if len(values) >= 2 and values[0] not in (None, "") and values[1] not in (None, ""):
                conditions.append([[ entity_name ]].[[ c.model_name ]].between(values[0], values[1]))
{% elif c.query_type_name == "LIKE" %}            conditions.append([[ entity_name ]].[[ c.model_name ]].ilike(f"%{value}%"))
{% elif c.query_type_name == "LIKE_LEFT" %}            conditions.append([[ entity_name ]].[[ c.model_name ]].ilike(f"%{value}"))
{% elif c.query_type_name == "LIKE_RIGHT" %}            conditions.append([[ entity_name ]].[[ c.model_name ]].ilike(f"{value}%"))
{% elif c.query_type_name == "IN" %}            values = (
                value
                if isinstance(value, list)
                else [item.strip() for item in str(value).split(",") if item.strip()]
            )
            if values:
                conditions.append([[ entity_name ]].[[ c.model_name ]].in_(values))
{% elif c.query_type_name == "GT" %}            conditions.append([[ entity_name ]].[[ c.model_name ]] > value)
{% elif c.query_type_name == "GE" %}            conditions.append([[ entity_name ]].[[ c.model_name ]] >= value)
{% elif c.query_type_name == "LT" %}            conditions.append([[ entity_name ]].[[ c.model_name ]] < value)
{% elif c.query_type_name == "LE" %}            conditions.append([[ entity_name ]].[[ c.model_name ]] <= value)
{% elif c.query_type_name == "NE" %}            conditions.append([[ entity_name ]].[[ c.model_name ]] != value)
{% else %}            conditions.append([[ entity_name ]].[[ c.model_name ]] == value)
{% endif %}{% endfor %}

        total = (
            await self.db.execute(select(func.count()).select_from([[ entity_name ]]).where(*conditions))
        ).scalar() or 0
        rows = (
            (
                await self.db.execute(
                    select([[ entity_name ]])
                    .where(*conditions)
                    .order_by([[ entity_name ]].id.desc())
                    .offset((query.pageNum - 1) * query.pageSize)
                    .limit(query.pageSize)
                )
            )
            .scalars()
            .all()
        )
        records = [[ lb ]][[ entity_name ]]VO.model_validate(row, from_attributes=True) for row in rows]
        return PageResult(
            records=records,
            total=total,
            pageNum=query.pageNum,
            pageSize=query.pageSize,
        )

